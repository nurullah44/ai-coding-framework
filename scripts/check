#!/usr/bin/env bash
# Framework self-check: lint the docs, then prove the lint catches each rule it enforces.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"

"$root/scripts/lint-docs" || exit 1

failed=0

# expect <exit code> <description> <shell that breaks a scratch copy>
expect() {
  local want="$1" name="$2" mutation="$3" scratch got
  # A setup error must not pass as the expected failure.
  if ! scratch="$(mktemp -d)" || ! cp -a "$root/." "$scratch/" || ! (cd "$scratch" && eval "$mutation"); then
    echo "FAIL lint-docs regression: '$name' could not set up its scratch copy"
    failed=1
    return
  fi
  "$scratch/scripts/lint-docs" > "$scratch/.out" 2>&1
  got=$?
  if [ "$got" -ne "$want" ]; then
    echo "FAIL lint-docs regression: '$name' exited $got, expected $want"
    sed 's/^/  /' "$scratch/.out"
    failed=1
  fi
  rm -rf "$scratch"
}

expect 1 "AGENTS.md over the line budget" 'seq 60 >> template/AGENTS.md'
expect 1 "51st line without a trailing newline" '{ cat AGENTS.md; seq $((50 - $(wc -l < AGENTS.md))); printf x; } > a && mv a AGENTS.md'
expect 1 "AGENTS.md over the token budget" 'head -c 4000 /dev/zero | tr "\0" a >> template/AGENTS.md'
expect 1 "missing path in backticks" 'echo "see \`docs/agents/nope.md\`" >> template/docs/agents/process.md'
expect 1 "broken relative link" 'echo "[x](roles/ghost.md)" >> template/docs/agents/process.md'
expect 1 "broken reference-style link" 'printf "[x][g]\n\n[g]: roles/ghost.md\n" >> template/docs/agents/process.md'
expect 1 "placeholder path under a missing directory" 'sed -i "s#\`.agents/skills/verify/features/<area>.md\`#\`features/<area>.md\`#" template/docs/agents/templates/task.md'
expect 1 "link whose name exists only in an ancestor" 'echo "[x](AGENTS.md)" >> template/docs/agents/process.md'
expect 1 "task template H2 renamed" 'sed -i "s/^## Out of scope/## Scope/" template/docs/agents/templates/task.md'
expect 1 "verdict template H2 removed" 'sed -i "/^## Not covered/d" template/docs/agents/templates/verdict.md'
expect 1 "feature entry missing H2s" 'printf "## Sub-features\n## Gotchas\n" > template/.agents/skills/verify/features/login.md'
expect 1 "verify command exits 0" 'sed -i "s/exit 2/exit 0/" template/.agents/skills/verify/verify'
expect 1 "skills symlink dangling" 'ln -sfn ../nowhere template/.claude/skills'
expect 1 "skills symlink to another skills dir" 'mkdir -p template/other/verify && touch template/other/verify/SKILL.md && ln -sfn ../other template/.claude/skills'
expect 1 "CLAUDE.md without @AGENTS.md" 'echo "# notes" > CLAUDE.md'
expect 1 "root hard rule renamed" 'sed -i "s/One blessed way/Single pattern/" AGENTS.md'
expect 0 "CLAUDE.md that imports AGENTS.md" 'printf "@AGENTS.md\n" > CLAUDE.md'
expect 0 "valid feature entry" 'printf "## Sub-features\n## How to get to it (user POV)\n## Driving it with verify\n## Gotchas\n" > template/.agents/skills/verify/features/login.md'

[ "$failed" -eq 0 ] || exit 1
echo "check: lint-docs regressions passed"

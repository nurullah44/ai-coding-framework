    # wait

    def wait(self, *args):
        return subprocess.run([RUN_ROLE, "wait", *args], cwd=self.root, env=self.env, capture_output=True, text=True)

    def test_wait_reports_each_finished_run_and_fails_when_one_failed(self):
        self.assertEqual(self.run_role("reviewer", "1", "--lane", "standards", "--harness", "claude").returncode, 0)
        self.assertEqual(self.run_role("reviewer", "1", "--lane", "spec", "--harness", "claude", mode="fail").returncode, 7)
        by_lane = {self.meta(run)["lane"]: run for run in self.runs()}
        ok, failed = by_lane["standards"], by_lane["spec"]
        with open(os.path.join(ok, "pid")) as fh:
            self.assertTrue(fh.read().strip().isdigit(), "a run records its run-role pid")
        r = self.wait(ok)
        self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
        self.assertIn(f"{ok}: exit 0", r.stdout)
        r = self.wait(ok, failed)
        self.assertEqual(r.returncode, 1)
        self.assertIn(f"{failed}: exit 7", r.stdout)
        self.assertEqual(self.wait().returncode, 0, "no unfinished run: nothing to wait for")
        self.assertEqual(self.wait(os.path.join(self.tmp, "nope")).returncode, 1)

    def test_wait_without_run_dirs_waits_for_every_unfinished_run(self):
        run = subprocess.Popen([RUN_ROLE, "reviewer", "1", "--lane", "standards", "--harness", "claude", "--timeout", "3"],
                               cwd=self.root, env={**self.env, "STUB_MODE": "hang"},
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.addCleanup(run.wait)
        deadline = time.time() + 10
        while not (self.runs() and os.path.exists(os.path.join(self.runs()[0], "pid"))):
            self.assertLess(time.time(), deadline, "the run dir never appeared")
            time.sleep(0.05)
        r = self.wait("--timeout", "1", "--interval", "0.1")
        self.assertEqual(r.returncode, 124, "still running at the wait's own timeout")
        self.assertIn("still running", r.stdout)
        r = self.wait("--interval", "0.1")
        self.assertEqual(r.returncode, 1, r.stdout + r.stderr)
        self.assertIn(f"{self.runs()[0]}: exit 124", r.stdout)

    def test_background_prints_the_run_dir_and_wait_follows_it(self):
        starts = [self.run_role("reviewer", "1", "--lane", lane, "--harness", "claude", "--background", mode="rendezvous")
                  for lane in ("spec", "standards")]
        for r in starts:
            self.assertEqual(r.returncode, 0, r.stderr)
        dirs = [r.stdout.strip() for r in starts]
        for d in dirs:
            self.assertTrue(os.path.isfile(os.path.join(d, "pid")), d)
        r = self.wait(*dirs)
        self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
        for d in dirs:
            self.assertIn(f"{d}: exit 0", r.stdout)
        self.assertEqual(len(self.calls()), 2, "both lanes ran, at the same time")

